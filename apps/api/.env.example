DATABASE_URI=postgres://animora:animora@localhost:5442/animora
PAYLOAD_SECRET=troca-isto-em-producao

# Shopify — o catálogo. Token de um custom app com read_products,
# read_inventory e write_inventory. Nunca NEXT_PUBLIC_: a Admin API
# não é chamada do browser.
SHOPIFY_LOJA=animora.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_troca-isto
SHOPIFY_WEBHOOK_SECRET=troca-isto

# As chaves a seguir pertencem à app `web` (Storefront/Customer Account API,
# chamadas do browser), não à `api` — ficam documentadas em
# apps/web/.env.example, não aqui.
